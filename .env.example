# ============================================================
# SCHRTYC ECOSISTEMA - Variables de Entorno
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env en la misma carpeta
#   2. Reemplaza TODOS los valores de ejemplo con valores reales
#   3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore)
# ============================================================

# ── Base de Datos (MariaDB) ──────────────────────────────────
DB_ROOT_PASSWORD=CAMBIA_ESTA_CONTRASENA_ROOT
DB_NAME=schrtyc_db
DB_USER=appuser
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_APP

# ── Autenticación JWT ────────────────────────────────────────
# Genera un secreto fuerte con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_POR_UNO_FUERTE

# ── Usuario Administrador Inicial (se crea en el primer arranque) ──
ADMIN_EMAIL=admin@radiotvycine.chiapas.gob.mx
# Genera el hash con: node -e "console.log(require('bcryptjs').hashSync('TuPassword', 10))"
ADMIN_HASH=$2b$10$CAMBIA_ESTE_HASH

# ── Entorno de Node ──────────────────────────────────────────
NODE_ENV=production

# ── CORS (dominios permitidos separados por coma) ────────────
# Agrega el dominio real de producción aquí
CORS_ORIGIN=https://radiotvycine.chiapas.gob.mx

# ── Google Sheets (opcional, para importación de parrillas) ──
# GOOGLE_KEY_FILE=./google-credentials.json
# SHEETS_ID=tu_id_de_google_sheets
